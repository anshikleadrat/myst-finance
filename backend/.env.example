# Copy to .env for local development. In production set these as real environment variables.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://myst:myst_dev_password@localhost:5432/myst_finance

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously stored PANs unreadable.
PII_ENCRYPTION_KEY=

# Public origin of the website (used for CSRF origin checks and cookie Secure flag).
SITE_URL=http://localhost:3000
EXTRA_ALLOWED_ORIGINS=

# Email OTP. "console" logs emails (dev). "smtp" sends via Gmail:
#   SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<16-char Google App Password>
#   (Google Account -> Security -> 2-Step Verification -> App passwords)
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=MYST Finance <you@gmail.com>
SUPPORT_EMAIL=support@mystfinance.in

# Development only: accounts @test.mystfinance.in log in with this fixed code and get no email.
# Seed them with `uv run python -m app.seed_dev`. Must be empty in production.
DEV_LOGIN_CODE=123456

# Payments. "mock" simulates checkout locally; "razorpay" needs keys from the Razorpay dashboard.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ACCESS_FEE_PAISE=19900

# Invoice details. Set BUSINESS_GSTIN to issue GST tax invoices (fee treated as GST-inclusive).
BUSINESS_NAME=MYST Finance
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
GST_RATE_PERCENT=18
