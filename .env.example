# Used by docker-compose.yml in production. Copy to .env and fill in.
DOMAIN=mystfinance.in
POSTGRES_PASSWORD=change-me

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Gmail SMTP with a Google App Password (Google Account -> Security -> App passwords)
MAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=MYST Finance <you@gmail.com>
SUPPORT_EMAIL=support@mystfinance.in

# Razorpay live/test keys and the webhook secret configured for https://$DOMAIN/api/payments/webhook
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ACCESS_FEE_PAISE=19900

BUSINESS_NAME=MYST Finance
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
GST_RATE_PERCENT=18
